# --- LLM Keys (Executive Filter & Conversational Brain via OpenRouter) ---
# Get an OpenRouter API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Models: wide selection on OpenRouter (e.g., anthropic/claude-3.7-sonnet, openai/gpt-4o, deepseek/deepseek-chat)
FILTER_MODEL=anthropic/claude-3.5-haiku
EXECUTIVE_MODEL=anthropic/claude-3.7-sonnet

# Optional direct Anthropic key (fallback if not using OpenRouter)
ANTHROPIC_API_KEY=

# --- Speech-to-Text (Local Always-On) ---
# Options: distil-large-v3, base.en, small.en
WHISPER_MODEL=distil-large-v3

# --- Text-to-Speech ---
# Leave ELEVENLABS_API_KEY empty to use local macOS 'say' / Piper fallback
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# --- Agent Watchers (Claude Code, OpenCode, Pi) ---
OPENCODE_SERVER_URL=http://127.0.0.1:4096
WATCH_CONFIG_PATH=./agents.json
