# --- LLM Keys (for Executive Filter & Conversational Brain) ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# --- Voice Biometrics ("Talk to me only") ---
# Free personal key from https://console.picovoice.ai/
PICOVOICE_ACCESS_KEY=
VOICEPRINT_PATH=~/.jarvis/owner.voiceprint
SPEAKER_SIMILARITY_THRESHOLD=0.65

# --- Speech-to-Text (Local Always-On) ---
# Options: distil-large-v3, base.en, small.en
WHISPER_MODEL=distil-large-v3

# --- Text-to-Speech ---
# Leave ELEVENLABS_API_KEY empty to use local macOS 'say' / Piper fallback
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# --- Agent Watchers (Claude Code, OpenCode, Pi) ---
OPENCODE_SERVER_URL=http://127.0.0.1:4096
WATCH_CONFIG_PATH=./agents.json
