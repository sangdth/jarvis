# --- LLMs (OpenRouter for both the executive and the filter) ---
# Get an OpenRouter API key at https://openrouter.ai/keys. Left empty, Jarvis only hears "shut up" / "you can talk".
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Executive: Jarvis's conversational brain; it also retells finished agent turns.
EXECUTIVE_MODEL=deepseek/deepseek-v4.1-flash
# Filter: decision model that tells whether each heard sentence is meant for Jarvis
FILTER_MODEL=typesafe/jev-1.14

# --- Speech-to-Text (Local Always-On) ---
# MLX Whisper model (Hugging Face id), e.g. mlx-community/distil-whisper-large-v3, mlx-community/whisper-large-v3-turbo
WHISPER_MODEL=mlx-community/distil-whisper-large-v3

# --- Audio ---
# true for laptop speakers (Jarvis would hear itself); false with headphones, so you can interrupt it.
MUTE_MIC_WHILE_SPEAKING=true

# --- Text-to-Speech ---
# ElevenLabs key (starts with sk_). Left empty, Jarvis cannot speak; it only beeps.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# --- Agent Watchers (Claude Code, OpenCode) ---
# Exact agents.json id that gets "build X" / "fix Y" when you don't name an agent; empty = first enabled agent
DEFAULT_CODING_AGENT=opencode

# Set the same value when starting `opencode serve`, so Jarvis can log in to its API
OPENCODE_SERVER_PASSWORD=
WATCH_CONFIG_PATH=./agents.json
