# --- LLMs (OpenRouter for both the executive and the filter) ---
# Get an OpenRouter API key at https://openrouter.ai/keys. Left empty, Jarvis only hears "shut up" / "you can talk".
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Executive: Jarvis's conversational brain; it also retells finished agent turns.
EXECUTIVE_MODEL=deepseek/deepseek-v4.1-flash
# Filter: the speech check's fallback, a decision model asked when Laya fails or is slow
FILTER_MODEL=typesafe/jev-1.14
# Laya: self-hosted speech check asked before FILTER_MODEL (which stays the fallback). A console key from
# https://laya.happyvoxel.com (laya_..., expires after 90 days); empty = FILTER_MODEL only.
LAYA_API_KEY=
LAYA_BASE_URL=https://laya.happyvoxel.com
LAYA_MODEL=jarvis-intent
LAYA_TIMEOUT_SECS=1.0
# Extraction: picks facts out of each exchange for long-term memory. Use a fast, non-thinking model.
EXTRACTION_MODEL=deepseek/deepseek-v4.1-flash

# --- Speech-to-Text (Local Always-On) ---
# The language you speak: en or vi. It picks the Whisper model and the language it listens for.
LANGUAGE=en
# Empty = picked from LANGUAGE (en: mlx-community/whisper-large-v3-turbo, vi: sangdth/phowhisper-large-vien-cs-mlx-16bit).
# Any MLX Whisper model (Hugging Face id or local folder) overrides it.
WHISPER_MODEL=

# --- Master check ---
# true: Jarvis acts only on its master's voice. Record it first with `jarvis enroll`; with it on, Jarvis won't start
# without owner_voice.npy in its home. false: any voice may talk to Jarvis.
MASTER_CHECK=false
# With the master check on, sentences scoring below this are dropped. Tune from the "[Speaker] score=" log lines.
SPEAKER_THRESHOLD=0.35
# Keep the last N sentences heard (dropped ones too) as WAVs in clips/, to look into misses. 0 = off; it saves your voice.
SAVE_SEGMENTS=0
# Smart Turn: a pause ends your sentence only when your voice sounds done (up to 1.5 s mid-thought). false = 0.6 s pause.
SMART_TURN=true
# `jarvis meeting`: the virtual mic Jarvis speaks into (part of its name). Empty = BlackHole, then Teams, then Zoom.
MEETING_VIRTUAL_MIC=
# `jarvis meeting` with the master check on: ask = work a guest asks for waits for your yes; allow = it starts at once.
MEETING_GUESTS=ask

# --- Text-to-Speech ---
# ElevenLabs key (starts with sk_). Left empty, Jarvis cannot speak; it only beeps.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# --- Agent Watchers (Claude Code, OpenCode, Hermes) ---
# Exact agents.json id that gets "build X" / "fix Y" when you don't name an agent; empty = first enabled agent
DEFAULT_CODING_AGENT=t3-code

# Empty: Jarvis finds OpenCode 2's own service. Set it only to use an `opencode serve` you start with this password.
OPENCODE_SERVER_PASSWORD=
# Same value as API_SERVER_KEY in ~/.hermes/.env (with API_SERVER_ENABLED=true; at least 16 characters)
HERMES_API_KEY=
