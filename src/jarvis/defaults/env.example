# One .env for every app in this repository: the voice harness, the brain (`apps/brain`) and the
# cockpit (`apps/tui`). `jarvis` reads it from its state home; a dev checkout keeps its own.

# --- LLMs (OpenRouter for the executive, the speech check and memory) ---
# Get an OpenRouter API key at https://openrouter.ai/keys. Left empty, Jarvis only hears "shut up" / "you can talk".
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Executive: Jarvis's conversational brain; it also retells finished agent turns.
EXECUTIVE_MODEL=deepseek/deepseek-v4.1-flash
# Filter: the speech check's fallback, a decision model asked when Laya fails or is slow
FILTER_MODEL=typesafe/jev-1.14
# Cleanup: tidies spoken slips, fillers and long sentences ("42, sorry, 24") before Jarvis reads them.
# Adds about 250-500 ms to sentences over 18 words or with a filler/cue. CLEANUP_MODEL empty = EXECUTIVE_MODEL, thinking off.
TRANSCRIPT_CLEANUP=true
CLEANUP_MODEL=
CLEANUP_CUES=sorry, no no, actually, scratch that, I mean, à quên, nhầm, ý mình là, ý anh là
# Laya: self-hosted speech check asked before FILTER_MODEL (which stays the fallback). A console key from
# https://laya.happyvoxel.com (laya_..., expires after 90 days); empty = FILTER_MODEL only.
LAYA_API_KEY=
LAYA_BASE_URL=https://laya.happyvoxel.com
LAYA_MODEL=jarvis-intent
LAYA_TIMEOUT_SECS=1.0
# Extraction: picks facts out of each exchange for long-term memory. Use a fast, non-thinking model.
EXTRACTION_MODEL=deepseek/deepseek-v4.1-flash

# --- Speech-to-Text (Local Always-On) ---
# The language you speak: en or vi. It picks the Whisper model and the language it listens for.
LANGUAGE=en
# Empty = picked from LANGUAGE (en: mlx-community/whisper-large-v3-turbo, vi: sangdth/phowhisper-large-vien-cs-mlx-16bit).
# Any MLX Whisper model (Hugging Face id or local folder) overrides it.
WHISPER_MODEL=

# --- Master check ---
# true: Jarvis acts only on its master's voice. Record it first with `jarvis enroll`; with it on, Jarvis won't start
# without owner_voice.npy in its home. false: any voice may talk to Jarvis.
MASTER_CHECK=false
# With the master check on, sentences scoring below this are dropped. Tune from the "[Speaker] score=" log lines.
SPEAKER_THRESHOLD=0.35
# Keep the last N sentences heard (dropped ones too) as WAVs in clips/, to look into misses. 0 = off; it saves your voice.
SAVE_SEGMENTS=0
# Smart Turn: a pause ends your sentence only when your voice sounds done (up to 1.5 s mid-thought). false = 0.6 s pause.
SMART_TURN=true
# `jarvis meeting` with the master check on: ask = work a guest asks for waits for your yes; allow = it starts at once.
MEETING_GUESTS=ask

# --- Text-to-Speech ---
# ElevenLabs key (starts with sk_). Left empty, Jarvis cannot speak; it only beeps.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# --- Thin client on another Mac (`jarvis remote`) ---
# The other Mac runs one small script and sends its mic and speaker here; Whisper, the agents and the models stay
# here. The port listens on the network, so keep it token-protected: every connection needs the token.
REMOTE_PORT=47210
# Empty = a random token kept in remote_token (0600), made on first use. Set one to pair Macs yourself.
REMOTE_TOKEN=

# --- The brain (`jarvis serve`, and in-process whenever `jarvis` listens) ---
# `jarvis` makes a random token in brain_token (0600) on first run and uses it for voice, brain and cockpit alike.
# Set one here only to use the brain from another machine (iPhone `/v1/ask` over Tailscale, a second Mac).
BRAIN_API_KEY=
# Where the daemon listens. Keep BRAIN_PORT in step with agents.json's `brain` url.
BRAIN_HOST=127.0.0.1
BRAIN_PORT=8643
# Where `jarvis` looks for it before starting one: a daemon answering here is attached to, not replaced.
BRAIN_URL=http://127.0.0.1:8643
# Where the brain may work autonomously: comma-separated folders under your projects dir (SOUL.md `projects_dir`).
# This repository (`jarvis`) is always allowed; nothing else is until you list it here.
ALLOWED_REPOS=
# A night's spend ceiling; the reconciler stops claiming tasks at it.
DAILY_BUDGET_USD=200.0
# ASSIST: only asks (and never claims background work). AUTONOMOUS: works through ready tasks overnight.
DEFAULT_MODE=ASSIST
# The `pi` binary the brain spawns for Planner/Builder workers.
PI_BIN=~/.local/bin/pi
# Seconds a single worker run may take, and a verify_cmd may run.
MAX_RUN_SECONDS=900
VERIFY_TIMEOUT_SECONDS=120
# Run workers inside macOS's `sandbox-exec`: no writes outside their worktree, no reading of keys or state.
SANDBOX_ENABLED=true
# Commands every self-upgrade of this repository must also pass (also rebuilds nothing on its own).
SELF_UPGRADE_VERIFY_CMD=

# --- Agent Watchers (T3 Code, Claude Code, OpenCode, the brain) ---
# Exact agents.json id that gets "build X" / "fix Y" when you don't name an agent; empty = first enabled agent
DEFAULT_CODING_AGENT=t3-code

# Empty: Jarvis finds OpenCode 2's own service. Set it only to use an `opencode serve` you start with this password.
OPENCODE_SERVER_PASSWORD=
# Only for a real Hermes Agent besides the brain (API_SERVER_KEY in ~/.hermes/.env, API_SERVER_ENABLED=true)
HERMES_API_KEY=
