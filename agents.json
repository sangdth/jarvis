{
  "agents": [
    {
      "id": "claude",
      "name": "Claude Code",
      "type": "claude_code",
      "cwd": ".",
      "command": [
        "claude",
        "-p",
        "--output-format",
        "stream-json",
        "--input-format",
        "stream-json",
        "--verbose",
        "--permission-mode",
        "acceptEdits"
      ],
      "enabled": true
    },
    {
      "id": "opencode",
      "name": "OpenCode",
      "type": "opencode_sse",
      "url": "http://127.0.0.1:4096",
      "enabled": true
    },
    {
      "id": "pi",
      "name": "Pi",
      "type": "acp_stdio",
      "cwd": ".",
      "command": [
        "pi",
        "--acp"
      ],
      "enabled": false
    }
  ]
}
