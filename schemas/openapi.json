{
  "openapi": "3.1.0",
  "info": {
    "title": "Jarvis gateway: HTTP, SSE and WebSocket",
    "version": "2.1.0",
    "description": "The one network surface of a Jarvis instance: the brain's run protocol (which routes each turn to a T3 Code thread, a one-shot pi answer, a minimal Claude/OpenCode turn, or the board), the cockpit's telemetry, the small operator API, device pairing, and the thin client's mic and speaker. Every route except `/health`, `GET /client.py` and `POST /v1/pair` needs a credential: the shared token (`Authorization: Bearer`, `?token=`, or `X-Jarvis-Token`), or a paired device's secret from `POST /v1/pair`. The shared token is `BRAIN_API_KEY`, else `JARVIS_HOME/brain_token`; paired devices live in `JARVIS_HOME/devices.json` as hashes, and only the shared token can mint or revoke them. Questions and approvals travel verbatim (`approval.request`, `question.request`) and are answered with `POST /v1/runs/{run_id}/answer`; no model decides them. WebSocket `/ws` carries 16-bit mono PCM at 16 kHz both ways plus JSON control frames (`hello`, `flush`); `GET /client.py` serves the zero-install thin client with this server's address filled in."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8643",
      "description": "A wildcard `BRAIN_HOST` means clients on this Mac use loopback; elsewhere use the machine's name."
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "RunStatus": {
        "type": "string",
        "enum": [
          "running",
          "completed",
          "failed",
          "cancelled"
        ]
      },
      "CreateRun": {
        "type": "object",
        "required": [
          "input"
        ],
        "properties": {
          "input": {
            "type": "string",
            "description": "The user's request, already in English."
          },
          "session_id": {
            "type": "string",
            "description": "Continue an earlier run's Pi session."
          },
          "replace": {
            "type": "boolean",
            "description": "Stop the run already working on this session and run this one instead."
          },
          "session": {
            "type": "string",
            "description": "\"new\" for a fresh thread, or \"continuing\" when `pinned` names one."
          },
          "cwd": {
            "type": "string",
            "description": "A project folder the voice already resolved."
          },
          "screenshot": {
            "type": "string",
            "description": "Absolute path to a front-window screenshot for this task."
          },
          "pinned": {
            "type": "object",
            "description": "`jarvis connect`: every task in this session goes to this client session.",
            "required": [
              "runner",
              "session_id"
            ],
            "properties": {
              "runner": {
                "type": "string",
                "enum": [
                  "t3",
                  "claude",
                  "opencode"
                ]
              },
              "session_id": {
                "type": "string"
              }
            }
          }
        }
      },
      "Run": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string"
          },
          "session_id": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "output": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        }
      },
      "Approval": {
        "type": "object",
        "required": [
          "choice"
        ],
        "properties": {
          "choice": {
            "type": "string",
            "enum": [
              "once",
              "deny"
            ]
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "Ask": {
        "type": "object",
        "required": [
          "input"
        ],
        "properties": {
          "input": {
            "type": "string"
          }
        }
      },
      "Spoken": {
        "type": "object",
        "properties": {
          "spoken": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "service": {
            "type": "string",
            "const": "jarvis"
          },
          "version": {
            "type": "string",
            "description": "The running checkout: branch and commit, `+dirty` if edited."
          },
          "pid": {
            "type": "integer"
          },
          "uptime_s": {
            "type": "number"
          }
        }
      },
      "Status": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "version": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "home": {
            "type": "string"
          },
          "pid": {
            "type": "integer"
          },
          "uptime_s": {
            "type": "number"
          },
          "mode": {
            "type": "string",
            "enum": [
              "ASSIST",
              "AUTONOMOUS"
            ]
          },
          "spent_today_usd": {
            "type": "number"
          },
          "daily_budget_usd": {
            "type": "number"
          },
          "budget_remaining_usd": {
            "type": "number"
          },
          "tasks": {
            "type": "integer"
          },
          "tasks_ready": {
            "type": "integer"
          },
          "tasks_running": {
            "type": "integer"
          },
          "skills_active": {
            "type": "integer"
          },
          "approvals_waiting": {
            "type": "integer"
          },
          "telemetry_seq": {
            "type": "integer"
          },
          "voice": {
            "type": "object",
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "starting",
                  "listening",
                  "stopped"
                ]
              },
              "meeting": {
                "type": "boolean"
              },
              "remote": {
                "type": "boolean",
                "description": "A paired Mac is the mic and speaker right now (same as `client`: there is no separate remote mode)."
              },
              "client": {
                "type": "boolean",
                "description": "A thin client is connected as the mic and speaker."
              },
              "local_audio": {
                "type": "boolean",
                "description": "This Mac has a mic and speaker to fall back on; false on a headless Mac, which waits for a paired device."
              },
              "port": {
                "type": "integer"
              }
            }
          }
        }
      },
      "Task": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "goal",
              "problem"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "ASSIST",
              "AUTONOMOUS"
            ]
          },
          "repo": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "spec": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "ready",
              "in_progress",
              "done",
              "blocked"
            ]
          }
        }
      },
      "AddTask": {
        "type": "object",
        "required": [
          "kind",
          "repo",
          "title",
          "spec"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "goal",
              "problem"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "ASSIST",
              "AUTONOMOUS"
            ]
          },
          "repo": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "spec": {
            "type": "string"
          },
          "metric": {
            "type": "string"
          },
          "verify": {
            "type": "string"
          },
          "priority": {
            "type": "integer"
          },
          "ready": {
            "type": "boolean"
          }
        }
      },
      "Mode": {
        "type": "object",
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "ASSIST",
              "AUTONOMOUS"
            ]
          }
        }
      },
      "Event": {
        "type": "object",
        "description": "One SSE `data:` line. Events: run.status, approval.request, approval.responded, run.completed, run.failed, run.cancelled, http.inbound, http.completed, reconciler.phase, board.rpc, pi.progress, attempt.finished, heartbeat.",
        "additionalProperties": true
      },
      "Resolve": {
        "type": "object",
        "properties": {
          "approved": {
            "type": "boolean",
            "description": "What the cockpit sends."
          },
          "action": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ],
            "description": "The same thing, spelled out."
          }
        }
      },
      "Device": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "last_seen": {
            "type": "string"
          },
          "revoked": {
            "type": "boolean"
          }
        }
      },
      "PairStart": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Six digits, single use, five minutes."
          },
          "expires_in": {
            "type": "integer"
          }
        }
      },
      "PairRequest": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "What this device is called in `jarvis devices`."
          }
        }
      },
      "PairResponse": {
        "type": "object",
        "properties": {
          "device": {
            "$ref": "#/components/schemas/Device"
          },
          "secret": {
            "type": "string",
            "description": "Shown once; the device keeps it."
          }
        }
      },
      "Answer": {
        "type": "object",
        "required": [
          "answer"
        ],
        "properties": {
          "answer": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "ConnectRequest": {
        "type": "object",
        "properties": {
          "runner": {
            "type": "string",
            "enum": [
              "t3",
              "claude",
              "opencode"
            ]
          },
          "session_id": {
            "type": "string"
          },
          "project": {
            "type": "string",
            "description": "A listed folder, to narrow the list."
          }
        }
      },
      "Session": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          },
          "running": {
            "type": "boolean"
          }
        }
      },
      "OutboxItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "approval_request",
              "morning_brief",
              "blocker",
              "report"
            ]
          },
          "task_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "summary_spoken": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "spoken",
              "approved",
              "rejected"
            ]
          },
          "created_at": {
            "type": "string"
          }
        }
      },
      "Timer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "followup",
              "schedule"
            ]
          },
          "action": {
            "type": "string",
            "enum": [
              "task",
              "check"
            ]
          },
          "cron_expr": {
            "type": [
              "string",
              "null"
            ]
          },
          "timezone": {
            "type": "string"
          },
          "next_run_at": {
            "type": "string"
          },
          "repo": {
            "type": [
              "string",
              "null"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "ASSIST",
              "AUTONOMOUS"
            ]
          },
          "title": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "verify_cmd": {
            "type": [
              "string",
              "null"
            ]
          },
          "max_cost_usd": {
            "type": [
              "number",
              "null"
            ]
          },
          "created_by": {
            "type": "string",
            "enum": [
              "owner",
              "agent"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "firing",
              "paused",
              "done"
            ]
          },
          "task_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "chain_count": {
            "type": "integer"
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        }
      },
      "AddTimer": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "in": {
            "type": "string",
            "description": "One-shot delay, e.g. '30m' or '2h'."
          },
          "at": {
            "type": "string",
            "description": "One-shot time: ISO 8601 or 'HH:MM'."
          },
          "every": {
            "type": "string",
            "description": "Five-field cron in `timezone`."
          },
          "timezone": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "prompt": {
            "type": "string",
            "description": "What to check; defaults to the title."
          },
          "action": {
            "type": "string",
            "enum": [
              "task",
              "check"
            ]
          },
          "repo": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "ASSIST",
              "AUTONOMOUS"
            ]
          },
          "verify": {
            "type": "string"
          },
          "max_cost_usd": {
            "type": "number"
          }
        },
        "oneOf": [
          {
            "required": [
              "in"
            ]
          },
          {
            "required": [
              "at"
            ]
          },
          {
            "required": [
              "every"
            ]
          }
        ]
      }
    }
  },
  "paths": {
    "/v1/pair/start": {
      "post": {
        "summary": "Mint a one-time pairing code (owner only)",
        "responses": {
          "200": {
            "description": "The code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairStart"
                }
              }
            }
          },
          "401": {
            "description": "Not the owner's shared token"
          }
        }
      }
    },
    "/v1/pair": {
      "post": {
        "summary": "Trade a pairing code for this device's own secret (no credential needed)",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PairRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairResponse"
                }
              }
            }
          },
          "403": {
            "description": "Wrong or expired code"
          },
          "429": {
            "description": "Too many attempts: mint a new code"
          }
        }
      }
    },
    "/v1/devices": {
      "get": {
        "summary": "List paired devices (owner only)",
        "responses": {
          "200": {
            "description": "Devices, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "devices": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Device"
                      }
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Owner token required"
          }
        }
      }
    },
    "/v1/devices/{device_id}/revoke": {
      "post": {
        "summary": "Revoke one device (owner only)",
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Revoked"
          },
          "404": {
            "description": "Unknown device"
          },
          "401": {
            "description": "Owner token required"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Liveness probe; the only route without a token",
        "security": [],
        "responses": {
          "200": {
            "description": "A Jarvis is here",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/status": {
      "get": {
        "summary": "Version, uptime, mode, spend, task counts, voice state",
        "responses": {
          "200": {
            "description": "Everything a probe or `jarvis status` needs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/board": {
      "get": {
        "summary": "The full board in one body: state, tasks, attempts, skills, outbox",
        "description": "What a remote cockpit draws, with no direct SQLite access.",
        "responses": {
          "200": {
            "description": "Board snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/v1/tasks": {
      "get": {
        "summary": "List tasks, optionally filtered by `?status=`",
        "responses": {
          "200": {
            "description": "Tasks",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tasks": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Task"
                      }
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Queue a goal or a problem (what `jarvis add` calls)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddTask"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The stored task"
          },
          "400": {
            "description": "Refused (repo not allowed, missing field)"
          }
        }
      }
    },
    "/v1/tasks/{task_id}/research": {
      "post": {
        "summary": "Run the SoL-Pi hypothesis fan-out on a task",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Outcome, summary and produced hypothesis ids"
          }
        }
      }
    },
    "/v1/mode": {
      "post": {
        "summary": "Switch between ASSIST and AUTONOMOUS",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Mode"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The new mode and the budget left"
          },
          "400": {
            "description": "Unknown mode"
          }
        }
      }
    },
    "/v1/skills/improve": {
      "post": {
        "summary": "Run the skill reflection loop on recent attempts",
        "responses": {
          "200": {
            "description": "Outcome, summary and the skills changed"
          }
        }
      }
    },
    "/v1/restart": {
      "post": {
        "summary": "Restart this Jarvis on the current checkout (voice included)",
        "description": "Used after an edit: the supervisor stops this process cleanly and launchd starts the new code.",
        "responses": {
          "200": {
            "description": "Restart scheduled"
          },
          "409": {
            "description": "Not supervised: nothing to restart it"
          }
        }
      }
    },
    "/v1/runs": {
      "post": {
        "summary": "Start a Planner run from a spoken request",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRun"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs/{run_id}": {
      "get": {
        "summary": "A run's status (the fallback when the event stream drops)",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "404": {
            "description": "Unknown run"
          }
        }
      }
    },
    "/v1/runs/{run_id}/events": {
      "get": {
        "summary": "Server-sent events for one run",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "text/event-stream of Event objects",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs/{run_id}/approval": {
      "post": {
        "summary": "Answer a pending approval",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Approval"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resolved"
          }
        }
      }
    },
    "/v1/runs/{run_id}/stop": {
      "post": {
        "summary": "Stop a run",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stopped"
          }
        }
      }
    },
    "/v1/ask": {
      "post": {
        "summary": "One-shot request, answer spoken back (iOS Shortcut / Action Button over Tailscale)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Ask"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Spoken"
                }
              }
            }
          }
        }
      }
    },
    "/v1/telemetry/events": {
      "get": {
        "summary": "Live telemetry for the cockpit (ring buffer, then live)",
        "responses": {
          "200": {
            "description": "text/event-stream of Event objects",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          }
        }
      }
    },
    "/v1/telemetry/snapshot": {
      "get": {
        "summary": "Current state in one JSON body: what a client draws on first paint",
        "responses": {
          "200": {
            "description": "System state, tasks, attempts, skills and outbox",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/v1/outbox/{outbox_id}/resolve": {
      "post": {
        "summary": "Approve or reject a queued outbox item (an approval, a report)",
        "parameters": [
          {
            "name": "outbox_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Resolve"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resolved"
          }
        }
      }
    },
    "/client.py": {
      "get": {
        "summary": "The zero-install thin client, with this server's URL and token already filled in",
        "description": "Open on purpose: the bootstrap has to arrive before the laptop has a secret, and it carries none \u2014 only this server's address. Served whenever Jarvis runs; no remote mode is started. `curl -fsSL 'http://<host>:8643/client.py' -o ~/.local/bin/jarvis-remote.py`, then `uv run ~/.local/bin/jarvis-remote.py --pair <code>`.",
        "responses": {
          "200": {
            "description": "text/x-python",
            "content": {
              "text/x-python": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/ws": {
      "get": {
        "summary": "The thin client's mic and speaker (WebSocket upgrade, always served)",
        "description": "Binary frames are 16-bit mono PCM at 16 kHz both ways. JSON control: `{\"type\":\"hello\",\"rate\":16000}` down on connect, `{\"type\":\"flush\"}` down on an interruption. One client at a time: they share one ear. While it is connected it owns the mic and speaker instead of the host Mac's, and it hands them back when it disconnects.",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "101": {
            "description": "Switched protocols"
          },
          "401": {
            "description": "Wrong token"
          },
          "404": {
            "description": "Not a relay path"
          }
        }
      }
    },
    "/v1/runs/{run_id}/answer": {
      "post": {
        "summary": "Answer the pending question or approval (free text; no model decides it)",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Answer"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resolved"
          }
        }
      }
    },
    "/v1/sessions": {
      "get": {
        "summary": "List a runner's sessions/threads (newest first)",
        "parameters": [
          {
            "name": "runner",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "t3"
            }
          },
          {
            "name": "project",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sessions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "runner": {
                      "type": "string"
                    },
                    "sessions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Session"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/connect": {
      "post": {
        "summary": "Pin one session for this run, or list what can be picked (`jarvis connect`)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pinned session or the pickable list"
          }
        }
      }
    },
    "/v1/events": {
      "get": {
        "summary": "SSE stream of events no voice-initiated run is waiting on",
        "responses": {
          "200": {
            "description": "text/event-stream"
          }
        }
      }
    },
    "/v1/outbox": {
      "get": {
        "summary": "List outbox items, by default what the voice has not taken yet",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "queued",
                "spoken",
                "approved",
                "rejected"
              ],
              "default": "queued"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "outbox": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/OutboxItem"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/outbox/{outbox_id}/spoken": {
      "post": {
        "summary": "Acknowledge that the voice took an outbox item",
        "parameters": [
          {
            "name": "outbox_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Acknowledged"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/v1/timers": {
      "get": {
        "summary": "List follow-ups and schedules",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "firing",
                "paused",
                "done"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Timers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "timers": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Timer"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a follow-up (`in`/`at`) or a schedule (`every`)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddTimer"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "timer": {
                      "$ref": "#/components/schemas/Timer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid timer"
          }
        }
      }
    },
    "/v1/timers/{timer_id}/cancel": {
      "post": {
        "summary": "Cancel one timer",
        "parameters": [
          {
            "name": "timer_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cancelled"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    }
  }
}
