{
  "openapi": "3.1.0",
  "info": {
    "title": "Superbrain HTTP/SSE contract",
    "version": "1.0.0",
    "description": "The brain's wire protocol: the five endpoints the voice harness drives (the HermesAdapter contract), the iPhone `/v1/ask` shortcut, and the cockpit's telemetry/operator endpoints. Every route needs `Authorization: Bearer <SUPERBRAIN_API_KEY>`; `jarvis` shares that token through JARVIS_HOME/brain_token. Clients in other languages (a React client, a Go service) generate their types from this file."
  },
  "servers": [{ "url": "http://127.0.0.1:8643" }],
  "security": [{ "bearer": [] }],
  "components": {
    "securitySchemes": {
      "bearer": { "type": "http", "scheme": "bearer" }
    },
    "schemas": {
      "RunStatus": { "type": "string", "enum": ["running", "completed", "failed", "cancelled"] },
      "CreateRun": {
        "type": "object",
        "required": ["input"],
        "properties": {
          "input": { "type": "string", "description": "The user's request, already in English." },
          "session_id": { "type": "string", "description": "Continue an earlier run's Pi session." }
        }
      },
      "Run": {
        "type": "object",
        "properties": {
          "run_id": { "type": "string" },
          "session_id": { "type": "string" },
          "status": { "$ref": "#/components/schemas/RunStatus" },
          "output": { "type": "string" },
          "error": { "type": "string" }
        }
      },
      "Approval": {
        "type": "object",
        "required": ["choice"],
        "properties": {
          "choice": { "type": "string", "enum": ["once", "deny"] },
          "request_id": { "type": "string" }
        }
      },
      "Ask": {
        "type": "object",
        "required": ["input"],
        "properties": { "input": { "type": "string" } }
      },
      "Spoken": {
        "type": "object",
        "properties": { "spoken": { "type": "string" } }
      },
      "Event": {
        "type": "object",
        "description": "One SSE `data:` line. Events: run.status, approval.request, approval.responded, run.completed, run.failed, run.cancelled, http.inbound, http.completed, reconciler.phase, board.rpc, pi.progress, attempt.finished, heartbeat.",
        "additionalProperties": true
      },
      "Resolve": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "action": { "type": "string", "enum": ["approve", "reject"] },
          "note": { "type": "string" }
        }
      }
    }
  },
  "paths": {
    "/v1/runs": {
      "post": {
        "summary": "Start a Planner run from a spoken request",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateRun" } } } },
        "responses": { "200": { "description": "Accepted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Run" } } } } }
      }
    },
    "/v1/runs/{run_id}": {
      "get": {
        "summary": "A run's status (the fallback when the event stream drops)",
        "parameters": [{ "name": "run_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Run" } } } }, "404": { "description": "Unknown run" } }
      }
    },
    "/v1/runs/{run_id}/events": {
      "get": {
        "summary": "Server-sent events for one run",
        "parameters": [{ "name": "run_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "text/event-stream of Event objects", "content": { "text/event-stream": { "schema": { "$ref": "#/components/schemas/Event" } } } } }
      }
    },
    "/v1/runs/{run_id}/approval": {
      "post": {
        "summary": "Answer a pending approval",
        "parameters": [{ "name": "run_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Approval" } } } },
        "responses": { "200": { "description": "Resolved" } }
      }
    },
    "/v1/runs/{run_id}/stop": {
      "post": {
        "summary": "Stop a run",
        "parameters": [{ "name": "run_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Stopped" } }
      }
    },
    "/v1/ask": {
      "post": {
        "summary": "One-shot request, answer spoken back (iOS Shortcut / Action Button over Tailscale)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ask" } } } },
        "responses": { "200": { "description": "Answer", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Spoken" } } } } }
      }
    },
    "/v1/telemetry/events": {
      "get": {
        "summary": "Live telemetry for the cockpit (ring buffer, then live)",
        "responses": { "200": { "description": "text/event-stream of Event objects", "content": { "text/event-stream": { "schema": { "$ref": "#/components/schemas/Event" } } } } }
      }
    },
    "/v1/telemetry/snapshot": {
      "get": {
        "summary": "Current state in one JSON body: what a client draws on first paint",
        "responses": { "200": { "description": "System state, tasks, attempts, skills and outbox", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } } }
      }
    },
    "/v1/outbox/{outbox_id}/resolve": {
      "post": {
        "summary": "Approve or reject a queued outbox item (an approval, a report)",
        "parameters": [{ "name": "outbox_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Resolve" } } } },
        "responses": { "200": { "description": "Resolved" } }
      }
    }
  }
}
